!/assets/materials/**/*.png
!/usd/assets/plant_sprout/plant_sprout_abstract/*.png
!/textures/*.exr
!/usd/assets/robots/muvi/source/Robot_muvi/textures/*.exr
!/usd/source/blender/textures/*.exr
