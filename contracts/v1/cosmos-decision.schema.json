{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenhouse.local/contracts/v1/cosmos-decision.schema.json",
  "title": "Cosmos Greenhouse Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decisionId", "snapshotId", "createdAt", "model", "summary", "riskLevel", "confidence", "proposedActions"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "decisionId": {"type": "string", "minLength": 1},
    "snapshotId": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "model": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "riskLevel": {"enum": ["none", "low", "medium", "high", "critical"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "proposedActions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actionId", "actionType", "targetId", "parameters", "reason", "confidence", "approvalPolicy"],
        "properties": {
          "actionId": {"type": "string", "minLength": 1},
          "actionType": {"enum": ["set-fan-speed", "set-window-position", "irrigate-zone", "set-sprayer", "set-light-level", "set-door-position", "raise-alert", "request-inspection", "no-action"]},
          "targetId": {"type": "string", "minLength": 1},
          "parameters": {"type": "object"},
          "reason": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "approvalPolicy": {"enum": ["automatic-allowed", "operator-required", "prohibited"]}
        }
      }
    }
  }
}
