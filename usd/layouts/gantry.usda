    def Camera "Shot_drone" (
        prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
        hide_in_stage_window = false
        no_delete = false
    )
    {
        float4[] clippingPlanes = []
        float2 clippingRange = (0.01, 10000000)
        float exposure = 0
        float exposure:fStop = 5
        float exposure:iso = 100
        float exposure:responsivity = 1.1026709
        float exposure:time = 0.02
        float focalLength = 18.147562
        float focusDistance = 400
        float fStop = 0
        float horizontalAperture = 20.955
        float horizontalApertureOffset = 0
        custom vector3d omni:kit:centerOfInterest = (0, 0, -34.07463231126343)
        custom float omni:rtx:autoExposure:adaptationSpeed = 3.5
        custom bool omni:rtx:autoExposure:enabled = 0
        custom bool omni:rtx:autoExposure:histogramClamping:enabled = 1
        custom float omni:rtx:autoExposure:histogramClamping:maxLuminance = 100000
        custom float omni:rtx:autoExposure:histogramClamping:minLuminance = 50
        custom token omni:rtx:autoExposure:histogramFilter = "median"
        custom float omni:rtx:autoExposure:whitePointScale = 10
        token projection = "perspective"
        uniform token purpose = "default"
        double shutter:close = 0
        double shutter:open = 0
        uniform token stereoRole = "mono"
        float verticalAperture = 15.2908
        float verticalApertureOffset = 0
        token visibility = "inherited"
        float3 xformOp:rotateYXZ = (65.9, -8.190251e-9, 0.097229764)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.20341329069711023, -37.46510873113019, 11.15402116068263)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateYXZ", "xformOp:scale"]
    }

    def Camera "Camera_01" (
        prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
    )
    {
        float exposure:fStop = 5
        float exposure:responsivity = 1.1026709
        float exposure:time = 0.02
        token visibility = "invisible"
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def OmniGraph "PushGraph"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "push"
        token fabricCacheBacking = "StageWithoutHistory"
        int2 fileFormatVersion = (1, 9)
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "Shot_droneCurveNode"
        {
            custom string inputs:IndividualOutputs
            custom rel inputs:Prim = </World/Shot_drone> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom timecode inputs:Time
            custom bool inputs:UseGlobalTime
            token node:type = "omni.anim.curve.core.AnimCurve"
            int node:typeVersion = 5
            custom rel outputs_AnimFrame (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
