#usda 1.0
(
    defaultPrim = "World"
    doc = "Plant inspection gantry, structural brackets, materials, and irrigation clearance overrides."
    metersPerUnit = 1
    upAxis = "Y"
)

over Xform "World"
{
    def Scope "Sensors"
    {
        def Xform "PlantInspectionGantry" (
            kind = "assembly"
        )
        {
            custom uniform token gantry:cameraAxis = "X"
            custom double2 gantry:cameraLimits = (-5.75, 5.75)
            custom uniform token gantry:longitudinalAxis = "Y"
            custom double2 gantry:longitudinalLimits = (-7.4, 7.4)

            def Xform "Frame"
            {
                def Cube "Rail_Left"
                {
                    rel material:binding = </World/Looks/GantryAluminum>
                    double size = 1
                    double3 xformOp:scale = (0.05, 15, 0.05)
                    double3 xformOp:translate = (-5.8, 0, 2.2)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "Rail_Right"
                {
                    rel material:binding = </World/Looks/GantryAluminum>
                    double size = 1
                    double3 xformOp:scale = (0.05, 15, 0.05)
                    double3 xformOp:translate = (5.2, 0, 2.2)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Scope "CrossTieBrackets"
                {
                    def Cube "Bracket_Left_Front"
                    {
                        rel material:binding = </World/Looks/GantrySteel>
                        double size = 1
                        double3 xformOp:scale = (0.24, 0.22, 0.245)
                        double3 xformOp:translate = (-5.8, -5.6666665, 2.3225)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    }

                    def Cube "Bracket_Left_Center"
                    {
                        rel material:binding = </World/Looks/GantrySteel>
                        double size = 1
                        double3 xformOp:scale = (0.24, 0.22, 0.245)
                        double3 xformOp:translate = (-5.8, 0, 2.3225)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    }

                    def Cube "Bracket_Left_Rear"
                    {
                        rel material:binding = </World/Looks/GantrySteel>
                        double size = 1
                        double3 xformOp:scale = (0.24, 0.22, 0.245)
                        double3 xformOp:translate = (-5.8, 5.6666665, 2.3225)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    }

                    def Cube "Bracket_Right_Front"
                    {
                        rel material:binding = </World/Looks/GantrySteel>
                        double size = 1
                        double3 xformOp:scale = (0.24, 0.22, 0.245)
                        double3 xformOp:translate = (5.2, -5.6666665, 2.3225)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    }

                    def Cube "Bracket_Right_Center"
                    {
                        rel material:binding = </World/Looks/GantrySteel>
                        double size = 1
                        double3 xformOp:scale = (0.24, 0.22, 0.245)
                        double3 xformOp:translate = (5.2, 0, 2.3225)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    }

                    def Cube "Bracket_Right_Rear"
                    {
                        rel material:binding = </World/Looks/GantrySteel>
                        double size = 1
                        double3 xformOp:scale = (0.24, 0.22, 0.245)
                        double3 xformOp:translate = (5.2, 5.6666665, 2.3225)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    }
                }
            }

            def Xform "Horizontal_Mount"
            {
                custom uniform token motion:axis = "Y"
                custom double2 motion:limits = (-7.4, 7.4)
                double3 xformOp:translate = (0.2, 0, 2.15)
                uniform token[] xformOpOrder = ["xformOp:translate"]

                def Cube "CrossBeam"
                {
                    rel material:binding = </World/Looks/GantryAluminum>
                    double size = 1
                    double3 xformOp:scale = (12, 0.05, 0.05)
                    uniform token[] xformOpOrder = ["xformOp:scale"]
                }

                def Xform "Cam_mount"
                {
                    custom uniform token motion:axis = "X"
                    custom double2 motion:limits = (-5.75, 5.75)
                    double3 xformOp:translate = (-1.750000026077032, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate"]

                    def Cube "Carriage"
                    {
                        rel material:binding = </World/Looks/GantryCarriage>
                        double size = 1
                        double3 xformOp:scale = (0.1, 0.07, 0.07)
                        uniform token[] xformOpOrder = ["xformOp:scale"]
                    }

                    def Camera "PlantScanCamera" (
                        prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
                    )
                    {
                        float2 clippingRange = (0.01, 10000000)
                        float exposure:fStop = 5
                        float exposure:responsivity = 1.1026709
                        float exposure:time = 0.02
                        float focalLength = 18.147562
                        float focusDistance = 400
                        bool omni:kit:cameraLock = 1
                        custom uniform vector3d omni:kit:centerOfInterest = (0, 0, -22.82967390556285)
                        token visibility = "inherited"
                        float3 xformOp:rotateYXZ = (0, -0, -0)
                        double3 xformOp:scale = (0.10000000149011612, 0.10000000149011612, 0.05000000074505806)
                        double3 xformOp:translate = (0, 0, 2.500000037252903)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateYXZ", "xformOp:scale"]
                    }
                }
            }
        }
    }

    def Scope "Looks"
    {
        def Material "GantryAluminum"
        {
            token outputs:surface.connect = </World/Looks/GantryAluminum/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.32, 0.36, 0.4)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "GantrySteel"
        {
            token outputs:surface.connect = </World/Looks/GantrySteel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.2, 0.22)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "GantryCarriage"
        {
            token outputs:surface.connect = </World/Looks/GantryCarriage/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.46, 0.04)
                float inputs:metallic = 0.35
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

