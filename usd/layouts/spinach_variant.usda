#usda 1.0
(
    doc = "Adds reusable plantSpecies prototypes to Beds 01-08 and exposes one all-bed species switch on the Plants prim."
    metersPerUnit = 1
    upAxis = "Y"
)

over "World"
{
    over "Environment"
    {
        over "Greenhouse"
        {
            over "Plants" (
                variants = {
                    string plantSpecies = "spinach"
                }
                prepend variantSets = "plantSpecies"
            )
            {
                over "Bed_01"
                {
                    over "PlantInstances"
                    {
                        rel prototypes = </World/Environment/Greenhouse/Plants/Bed_01/PlantInstances/Prototypes/PlantPrototype>

                        over "Prototypes"
                        {
                            def Xform "PlantPrototype" (
                                prepend references = @../assets/plants/plant_prototype.usda@</PlantPrototype>
                            )
                            {
                            }
                        }
                    }
                }

                over "Bed_02"
                {
