                            bool physics:collisionEnabled = 1
                        }
                    }
                over Xform "RA_Path_Edge_L" {
                        over Mesh "Cube_077" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"])
                        {
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 1
                        }
                    }
