#usda 1.0
(
    doc = "Simulation configuration boundary. Physics behavior is authored here after pivot and collision validation, never in the Blender exchange layer."
    metersPerUnit = 1
    upAxis = "Y"
)

over Xform "World"
{
    def Scope "Simulation"
    {
        custom uniform token simulation:gravityAxis = "Y"
        custom double simulation:gravityMagnitude = 9.81
        custom uniform token simulation:stateAuthority = "../runtime/live_state.usda"

        def Scope "Zones"
        {
        }

        def Scope "Devices"
        {
        }

        def Scope "State"
        {
        }

        def Cube "RobotAccessGroundCollider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            custom uniform token simulation:class = "staticCollider"
            custom string simulation:purpose = "Stable shooting surface beneath the exterior robot path"
            uniform token purpose = "guide"
            token visibility = "invisible"
            float3 xformOp:scale = (3.0, 7.0, 0.05)
            double3 xformOp:translate = (0, -15.5, 0.15)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def PhysicsScene "PhysicsScene"
        {
            vector3f physics:gravityDirection = (0, -1, 0)
            float physics:gravityMagnitude = 9.81
        }
    }

    over Xform "Environment"
    {
        over Xform "Greenhouse"
        {
            over Xform "Structure"
            {
                over Xform "Floor"
                {
                    over Mesh "Floor" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                        bool physics:collisionEnabled = 1
                    }
                }
            }

            over Xform "Doors"
            {
                over Xform "GH_Door_Front_Automatic"
                {
                    over Xform "GH_Door_Front_Panel_L" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                        custom uniform token simulation:class = "kinematicRigidBody"
                        custom string simulation:nextStep = "author prismatic joint and travel limits"
                        float physics:mass = 35
                        bool physics:kinematicEnabled = 1
                        bool physics:rigidBodyEnabled = 1

                        over Mesh "GH_Door_Front_Panel_L_Mesh" (
                            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                        )
                        {
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 1
                        }

                        over Xform "GH_Door_Front_Hanger_L"
                        {
                            over Mesh "GH_Door_Front_Hanger_L_Mesh" (
                                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                            )
                            {
                                uniform token physics:approximation = "convexHull"
                                bool physics:collisionEnabled = 1
                            }
                        }
                    }

                    over Xform "GH_Door_Front_Panel_R" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                        custom uniform token simulation:class = "kinematicRigidBody"
                        custom string simulation:nextStep = "author prismatic joint and travel limits"
                        float physics:mass = 35
                        bool physics:kinematicEnabled = 1
                        bool physics:rigidBodyEnabled = 1

                        over Mesh "GH_Door_Front_Panel_R_Mesh" (
                            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                        )
                        {
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 1
                        }

                        over Xform "GH_Door_Front_Hanger_R"
                        {
                            over Mesh "GH_Door_Front_Hanger_R_Mesh" (
                                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                            )
                            {
                                uniform token physics:approximation = "convexHull"
                                bool physics:collisionEnabled = 1
                            }
                        }
                    }
                }
            }

            over Xform "Plants"
            {
                over Xform "Walkways"
                {
                    over Xform "Walkway_01" {
                        over Mesh "Walkway_01" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"])
                        {
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 1
                        }
                    }
                    over Xform "Walkway_02" {
                        over Mesh "Walkway_02" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"])
                        {
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 1
                        }
                    }
                    over Xform "Walkway_03" {
                        over Mesh "Walkway_03" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"])
                        {
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 1
                        }
                    }
                    over Xform "Walkway_04" {
                        over Mesh "Walkway_04" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"])
                        {
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 1
                        }
                    }
                }

                over Xform "Bed_01" {
                        over PointInstancer "PlantInstances" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
                        {
                        bool physics:kinematicEnabled = 1
                        bool physics:rigidBodyEnabled = 1
                        over "Prototypes" {
                        over Mesh "PlantSprout" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysicsMassAPI"])
                        {
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 1
                            float physics:mass = 0.05
                        }
                    }
                }
            }
                over Xform "Bed_02" {
                        over PointInstancer "PlantInstances" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
                        {
                        bool physics:kinematicEnabled = 1
                        bool physics:rigidBodyEnabled = 1
                        over "Prototypes" {
                        over Mesh "PlantSprout" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysicsMassAPI"])
                        {
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 1
                            float physics:mass = 0.05
                        }
                    }
                }
            }
                over Xform "Bed_03" {
                        over PointInstancer "PlantInstances" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
                        {
                        bool physics:kinematicEnabled = 1
                        bool physics:rigidBodyEnabled = 1
                        over "Prototypes" {
                        over Mesh "PlantSprout" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysicsMassAPI"])
                        {
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 1
                            float physics:mass = 0.05
                        }
                    }
                }
            }
                over Xform "Bed_04" {
                        over PointInstancer "PlantInstances" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
                        {
                        bool physics:kinematicEnabled = 1
                        bool physics:rigidBodyEnabled = 1
                        over "Prototypes" {
                        over Mesh "PlantSprout" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysicsMassAPI"])
                        {
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 1
                            float physics:mass = 0.05
                        }
                    }
                }
            }
                over Xform "Bed_05" {
                        over PointInstancer "PlantInstances" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
                        {
                        bool physics:kinematicEnabled = 1
                        bool physics:rigidBodyEnabled = 1
                        over "Prototypes" {
                        over Mesh "PlantSprout" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysicsMassAPI"])
                        {
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 1
                            float physics:mass = 0.05
                        }
                    }
                }
            }
                over Xform "Bed_06" {
                        over PointInstancer "PlantInstances" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
                        {
                        bool physics:kinematicEnabled = 1
                        bool physics:rigidBodyEnabled = 1
                        over "Prototypes" {
                        over Mesh "PlantSprout" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysicsMassAPI"])
                        {
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 1
                            float physics:mass = 0.05
                        }
                    }
                }
            }
                over Xform "Bed_07" {
                        over PointInstancer "PlantInstances" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
                        {
                        bool physics:kinematicEnabled = 1
                        bool physics:rigidBodyEnabled = 1
                        over "Prototypes" {
                        over Mesh "PlantSprout" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysicsMassAPI"])
                        {
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 1
                            float physics:mass = 0.05
                        }
                    }
                }
            }
                over Xform "Bed_08" {
                        over PointInstancer "PlantInstances" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
                        {
                        bool physics:kinematicEnabled = 1
                        bool physics:rigidBodyEnabled = 1
                        over "Prototypes" {
                        over Mesh "PlantSprout" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysicsMassAPI"])
                        {
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 1
                            float physics:mass = 0.05
                        }
                    }
                }
            }
            }
        }

        over Xform "Exterior"
        {
            over Xform "RA_Robot_Access_ROOT"
            {
                over Xform "RA_Grass_Ground" {
                        over Mesh "Cube_062" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"])
                        {
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 1
                        }
                    }
                over Xform "RA_Entry_Threshold" {
                        over Mesh "Cube_063" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"])
                        {
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 1
                        }
                    }
                over Xform "RA_Stone_Path_01" {
