#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (-1.6525858917847942, 2.3107063219789468, 8.963816486327127)
                double3 target = (1.0335570657761366, -8.406265813282767, -23.40846757183813)
            }
            dictionary Right = {
                double3 position = (-5, 0, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 5, 0)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./greenhouse_spinach.usda"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "World"
    doc = "Greenhouse plant-species scenario with one shared selection controlling all eight beds."
    metersPerUnit = 1
    subLayers = [
        @../layouts/spinach_variant.usda@,
        @./greenhouse_main.usda@
    ]
    upAxis = "Y"
)

over Xform "World" (
    kind = "assembly"
)
{
    over "Robots"
    {
        over "MuviRobotControls"
        {
            over "differential_controller"
            {
                over "ArrayNames"
                {
                    custom token inputs:input0 (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    string resolvedType = "token"
                                }
                            }
                        }
                    )
                }
            }
        }
    }

    over "Simulation"
    {
        over "PhysicsScene" (
            prepend apiSchemas = ["PhysxSceneAPI"]
        )
        {
        }
    }

    over "Environment"
    {
        over "Greenhouse"
        {
            over "Plants" (
                variants = {
                    string plantSpecies = "sprout"
                }
            )
            {
                over "Bed_04"
                {
                    over "PlantInstances"
                    {
                        over "Prototypes"
                        {
                            over "PlantPrototype" (
                                prepend apiSchemas = ["MaterialBindingAPI"]
                                variants = {
                                    string plantSpecies = "sprout"
                                }
                            )
                            {
                                rel material:binding = </World/Looks/PlantSproutMat> (
                                    bindMaterialAs = "weakerThanDescendants"
                                )
                            }
                        }
                    }

