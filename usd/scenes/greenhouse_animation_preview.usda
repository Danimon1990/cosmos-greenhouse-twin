#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (4.73260369582744, 24.177394952853927, 19.862197301649964)
                double3 target = (3.6946488798696056, 0.23048319125713945, -3.287145562914098)
            }
            dictionary Right = {
                double3 position = (-5, 0, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 5, 0)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary metricsAssembler = {
            dictionary "/World/Boxwood" = {
            }
            dictionary "/World/Daphne" = {
            }
            dictionary "/World/Fountain_Grass_Short" = {
            }
            dictionary "/World/Gray_Birch" = {
            }
            dictionary "/World/Gray_Birch_01" = {
            }
            int version = 1
        }
        dictionary omni_layer = {
            string authoring_layer = "./greenhouse_animation_preview.usda"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "World"
    doc = "Open this stage to preview door, fan, and sprinkler animation without changing runtime state."
    endTimeCode = 240
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @../shots/animation_preview.usda@,
        @./greenhouse_main.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over Xform "World" (
    kind = "assembly"
)
{
    over "Environment"
    {
        over "Greenhouse"
        {
            token visibility = "inherited"

            over "Structure"
            {
                token visibility = "inherited"

                over "TunnelCover"
                {
                    token visibility = "invisible"
                }
            }

            over "Devices"
            {
                token visibility = "inherited"
            }

            over "Plants"
            {
                token visibility = "inherited"
            }

            over "Doors"
            {
                token visibility = "inherited"
            }

            over "Utilities"
            {
                token visibility = "inherited"

                over "US_Utility_Station_ROOT"
                {
                    over "US_Canopy_Solar_Panel" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </_materials/US_Black> (
                            bindMaterialAs = "weakerThanDescendants"
                        )
                    }
                }
            }

            over "Ventilation"
            {
                token visibility = "inherited"

                over "Fan_03"
                {
                    quatf xformOp:orient = (1, 0, 0, 0)
                    float3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                }
            }
        }

        over "Exterior"
        {
            over "RA_Robot_Access_ROOT"
            {
                over "Plants"
                {
                    token visibility = "invisible"
                }
            }
        }
    }

    def RectLight "RectLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float3[] extent = [(-50, -50, -0), (50, 50, 0)]
        float inputs:height = 95.4
        float inputs:intensity = 800
        float inputs:shaping:cone:angle = 180
        float inputs:shaping:cone:softness
        float inputs:shaping:focus
        color3f inputs:shaping:focusTint
        asset inputs:shaping:ies:file
        float inputs:width = 96.5
        custom int omni:rtx:usdluxVersion = 2505
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, -1.3526264884614492e-7, 3.951750259203381)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    over "Simulation"
    {
        over "PhysicsScene" (
            prepend apiSchemas = ["PhysxSceneAPI"]
        )
        {
        }
    }

    over "Robots"
    {
        over "MuviRobotControls"
        {
            over "differential_controller"
            {
                over "ArrayNames"
                {
                    custom token inputs:input0 (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    string resolvedType = "token"
                                }
                            }
                        }
                    )
                }
            }
        }

        over "MuviRobot"
        {
            over "Top"
            {
            }

            over "wheels"
            {
                over "Rear_Left_wheel"
                {
                }

                over "Rear_Right_wheel"
                {
                }

                over "Front_Right_wheel"
                {
                }

                over "Front_Left_wheel"
                {
                }
            }

            over "Front_Sensor"
            {
            }

            over "Articulation"
            {
                over "Top"
                {
                }

                over "wheels"
                {
                    over "Rear_Left_wheel"
                    {
                    }

                    over "Rear_Right_wheel"
                    {
                    }

                    over "Front_Right_wheel"
                    {
                    }

                    over "Front_Left_wheel"
                    {
                    }
                }

                over "Front_Sensor"
                {
                }
            }
        }
    }

    over "Sensors"
    {
        over "PlantInspectionGantry"
        {
            over "Horizontal_Mount"
            {
                double3 xformOp:translate = (0.2, -4.550000067800283, 2.15)

                over "Cam_mount"
                {
                    double3 xformOp:translate = (0.3500000052154064, 0, 0)

                    over "PlantScanCamera"
                    {
                        float focalLength = 16
                        double3 xformOp:scale = (0.10000000149011612, 0.10000000149011612, 0.05000000074505806)
                        double3 xformOp:translate = (0, 0, -0.07)
                    }

                    over "Carriage"
                    {
                        double3 xformOp:scale = (0.12, 0.09, 0.07)
                    }
                }
            }
        }
    }

    def "Daphne" (
        prepend payload = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Vegetation/Shrub/Daphne.usd@
    )
    {
        quatf xformOp:orient = (0.7400545, 0.6725469, 0, 0)
        double xformOp:rotateX:unitsResolve = -90
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:scale:unitsResolve = (0.009999999776482582, 0.009999999776482582, 0.009999999776482582)
        double3 xformOp:translate = (-2.273719423297465, -15.790090702072543, -0.0273651952879607)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve", "xformOp:scale:unitsResolve"]
    }

    def "Fountain_Grass_Short" (
        prepend payload = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Vegetation/Shrub/Fountain_Grass_Short.usd@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        double xformOp:rotateX:unitsResolve = -90
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:scale:unitsResolve = (0.009999999776482582, 0.009999999776482582, 0.009999999776482582)
        double3 xformOp:translate = (-3.0822323120217168, -22.704150194434764, 0.6754352938919574)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve", "xformOp:scale:unitsResolve"]
    }

    def "Gray_Birch" (
        prepend payload = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Vegetation/Trees/Gray_Birch.usd@
    )
    {
        quatf xformOp:orient = (0.70710677, 0.70710677, 0, 0)
        double xformOp:rotateX:unitsResolve = -90
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:scale:unitsResolve = (0.009999999776482582, 0.009999999776482582, 0.009999999776482582)
        double3 xformOp:translate = (9.838088649338028, 0.00000533914962560202, -0.035923273972166256)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve", "xformOp:scale:unitsResolve"]
    }

    def "Gray_Birch_01" (
        prepend payload = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Vegetation/Trees/Gray_Birch.usd@
    )
    {
        quatf xformOp:orient = (0.66405165, 0.66405165, 0.24297202, 0.24297203)
        double xformOp:rotateX:unitsResolve = -90
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:scale:unitsResolve = (0.009999999776482582, 0.009999999776482582, 0.009999999776482582)
        double3 xformOp:translate = (10.291821401882308, 11.165299632460984, -0.04087447036596277)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve", "xformOp:scale:unitsResolve"]
    }
}

over "Render"
{
    over "OmniverseKit"
    {
        over "HydraTextures"
        {
            over "omni_kit_widget_viewport_ViewportTexture_0"
            {
                rel camera = </OmniverseKit_Persp>
                bool omni:rtx:rt:ecoMode:enabled
                bool omni:rtx:scene:useViewLightingMode
                rel orderedVars = </Render/Vars/LdrColor>
                custom bool overrideClipRange = 0
                uniform int2 resolution = (1093, 644)
            }
        }
    }
}

over "OmniverseKit_Persp" (
    prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
    customData = {
        dictionary omni = {
            dictionary kit = {
                bool hide_in_stage_window = 1
                bool no_delete = 1
            }
        }
    }
    hide_in_stage_window = true
    kind = "component"
    no_delete = true
)
{
    float2 clippingRange = (0.01, 10000000)
    float exposure:fStop = 5
    float exposure:responsivity = 1.1026709
    float exposure:time = 0.02
    float focalLength = 18.147562
    float focusDistance = 400
    custom uniform vector3d omni:kit:centerOfInterest = (0, 0, -33.32302519548331)
    float3 xformOp:rotateXYZ = (-45.941452, 2.5672705, -5.7705475e-14)
    float3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (4.73260369582744, 24.177394952853927, 19.862197301649964)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
}

over "OmniverseKit_Front" (
    customData = {
        dictionary omni = {
            dictionary kit = {
                bool hide_in_stage_window = 1
                bool no_delete = 1
            }
        }
    }
    hide_in_stage_window = true
    kind = "component"
    no_delete = true
)
{
    float2 clippingRange = (1, 10000000)
    float horizontalAperture = 50
    custom uniform vector3d omni:kit:centerOfInterest = (0, 0, -5)
    token projection = "orthographic"
    float verticalAperture = 50
    float3 xformOp:rotateXYZ = (0, 0, 0)
    float3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 5)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
}

