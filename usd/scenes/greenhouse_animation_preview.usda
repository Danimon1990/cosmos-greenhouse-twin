over Xform "World" (
    kind = "assembly"
)
{
    over "Environment"
    {
        over "Greenhouse"
        {
            token visibility = "inherited"

            over "Structure"
            {
                token visibility = "inherited"

                over "TunnelCover"
                {
                    token visibility = "inherited"

                    over "TunnelCover"
                    {
                        token visibility = "invisible"
                    }
                }
            }

            over "Devices"
            {
                token visibility = "inherited"
            }

            over "Plants"
            {
                token visibility = "inherited"
            }

            over "Doors"
            {
                token visibility = "inherited"
            }

            over "Utilities"
            {
                token visibility = "inherited"

                over "US_Utility_Station_ROOT"
                {
                    over "US_Canopy_Solar_Panel" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </_materials/US_Black> (
                            bindMaterialAs = "weakerThanDescendants"
                        )
                    }
                }
            }

            over "Ventilation"
            {
                token visibility = "inherited"

                over "Fan_03"
                {
                    quatf xformOp:orient = (1, 0, 0, 0)
                    float3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                }
            }
        }

        over "Exterior"
        {
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "RA_Robot_Access_ROOT"
            {
                over "Plants"
                {
                    token visibility = "invisible"
                }
            }

            over "Wheelbarrow_PULL"
            {
                over "Wheelbarrow_Tray"
                {
                    over "Wheelbarrow_Tray_Mesh"
                    {
                        quatf xformOp:orient = (1, 0, 0, 0)
                        float3 xformOp:scale = (1, 1, 1)
                        double3 xformOp:translate = (7.105427357601002e-15, -2.2895463303029828e-11, 0.0006688701397727925)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                    }
                }
            }

            over "Shovel"
            {
                quatf xformOp:orient = (0.9891925, -0.14662273, 0, 0)
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (2.0773611749424146, -8.5915570350128, 0.10781985821210563)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }
    }

    def RectLight "RectLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float3[] extent = [(-50, -50, -0), (50, 50, 0)]
        float inputs:height = 95.4
        float inputs:intensity = 800
        float inputs:shaping:cone:angle = 180
        float inputs:shaping:cone:softness
        float inputs:shaping:focus
        color3f inputs:shaping:focusTint
        asset inputs:shaping:ies:file
        float inputs:width = 96.5
        custom int omni:rtx:usdluxVersion = 2505
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, -1.3526264884614492e-7, 3.951750259203381)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    over "Simulation"
    {
        over "PhysicsScene" (
            prepend apiSchemas = ["PhysxSceneAPI"]
        )
        {
        }
    }

    over "Robots"
    {
        over "MuviRobotControls"
        {
            over "differential_controller"
            {
                over "ArrayNames"
                {
                    custom token inputs:input0 (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    string resolvedType = "token"
                                }
                            }
                        }
                    )
                }
            }
        }

        over "MuviRobot"
        {
            token visibility = "invisible"
            double3 xformOp:translate = (0, -12.5, 0.2)

            over "Top"
            {
            }

            over "wheels"
            {
                over "Rear_Left_wheel"
                {
                }

                over "Rear_Right_wheel"
                {
                }

                over "Front_Right_wheel"
                {
                }

                over "Front_Left_wheel"
                {
                }
            }

            over "Front_Sensor"
            {
            }

            over "Articulation"
            {
                over "Top"
                {
                }

                over "wheels"
                {
                    over "Rear_Left_wheel"
                    {
                    }

                    over "Rear_Right_wheel"
                    {
                    }

                    over "Front_Right_wheel"
                    {
                    }

                    over "Front_Left_wheel"
                    {
                    }
                }

                over "Front_Sensor"
                {
                }
            }
        }
    }

    over "Sensors"
    {
        over "PlantInspectionGantry"
        {
            over "Horizontal_Mount"
            {
                double3 xformOp:translate = (0.2, -4.550000067800283, 2.15)

                over "Cam_mount"
                {
                    double3 xformOp:translate = (0.3500000052154064, 0, 0)

                    over "PlantScanCamera"
                    {
                        float focalLength = 16
                        double3 xformOp:scale = (0.10000000149011612, 0.10000000149011612, 0.05000000074505806)
                        double3 xformOp:translate = (0, 0, -0.07)
                    }

                    over "Carriage"
                    {
                        double3 xformOp:scale = (0.12, 0.09, 0.07)
                    }
                }
            }
        }
    }

