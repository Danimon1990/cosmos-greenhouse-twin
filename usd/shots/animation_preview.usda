#usda 1.0
(
    doc = "Deterministic 10-second preview of three fans and nine wide-coverage sprinkler particle emitters. Scenario animation is stronger than runtime state only in this preview stage."
    endTimeCode = 240
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./sprinkler_particle_preview.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over Xform "World"
{
    over Xform "Environment"
    {
        over Xform "Greenhouse"
        {
            over Xform "Ventilation"
            {
                over Xform "Fan_01"
                {
                    custom float command:speed = 1
                    over Xform "Fan_01_Rotor"
                    {
                        double xformOp:rotateY:actuation.timeSamples = { 0: 0, 240: 7200 }
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY:actuation", "xformOp:orient", "xformOp:scale"]
                    }
                }

                over Xform "Fan_02"
                {
                    custom float command:speed = 1
                    over Xform "Fan_02_Rotor"
                    {
                        double xformOp:rotateY:actuation.timeSamples = { 0: 0, 240: 7200 }
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY:actuation", "xformOp:orient", "xformOp:scale"]
                    }
                }

                over Xform "Fan_03"
                {
                    custom float command:speed = 1
                    over Xform "Fan_03_Rotor"
                    {
                        double xformOp:rotateY:actuation.timeSamples = { 0: 0, 240: 7200 }
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY:actuation", "xformOp:orient", "xformOp:scale"]
                    }
                }
            }

            over Xform "Irrigation"
            {
                custom bool command:sprayEnabled = true
                custom float command:flow = 0.75
            }
        }
    }

}
