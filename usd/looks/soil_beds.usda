#usda 1.0
(
    doc = "Shared realistic cultivated-soil look and planar UV overrides for greenhouse beds."
    metersPerUnit = 1
    upAxis = "Y"
)

over "_materials"
{
    over Material "GH_Bed_Rich_Dark_Soil"
    {
        over Shader "Ground_Surface"
        {
            color3f inputs:diffuseColor.connect = </_materials/GH_Bed_Rich_Dark_Soil/SoilAlbedo.outputs:rgb>
            float inputs:roughness = 0.91
            float inputs:specular = 0.24
        }

        def Shader "SoilUVReader"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }

        def Shader "SoilAlbedo"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @../../assets/materials/soil/greenhouse_soil_albedo_v1.png@
            token inputs:sourceColorSpace = "sRGB"
            float2 inputs:st.connect = </_materials/GH_Bed_Rich_Dark_Soil/SoilUVReader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }
    }
}

