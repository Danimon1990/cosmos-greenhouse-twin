#usda 1.0
(
    doc = "Non-destructive physics overrides for the MUVI robot asset."
)

def "MuviRobot"
{
    over "wheels"
    {
        over "Rear_Left_wheel" (
            prepend apiSchemas = ["PhysicsMassAPI"]
        )
        {
            vector3f physics:angularVelocity = (0, 0, 0)
            bool physics:kinematicEnabled = 0
            float physics:mass = 1.5
            vector3f physics:velocity = (0, 0, 0)
            custom float physxRigidBody:angularDamping = 0.8
            custom float physxRigidBody:linearDamping = 0.2
            float physxRigidBody:maxAngularVelocity = 100
            double3 xformOp:translate = (-0.42, -0.252202257514, 0.312523260713)

            over "Front_Right_10in_wheel_003"
            {
                double3 xformOp:translate = (0, 0, 0)

                over "RevoluteJoint" (
                    active = false
                )
                {
                }

                over "Cylinder_102"
                {
                    bool physics:collisionEnabled = 0
                }
            }

            def PhysicsRevoluteJoint "RevoluteJoint" (
                active = false
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                uniform token physics:axis = "X"
                rel physics:body0 = </MuviRobot/Top>
                rel physics:body1 = </MuviRobot/wheels/Rear_Left_wheel>
                float physics:breakForce = inf
                float physics:breakTorque = inf
                bool physics:collisionEnabled = 0
                float drive:angular:physics:damping = 10000
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetVelocity = 50
                uniform bool physics:excludeFromArticulation = 0
                bool physics:jointEnabled = 1
                point3f physics:localPos0 = (-0.42, -0.25220227, 0.31252328)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
                float physics:lowerLimit = -inf
                float physics:upperLimit = inf
            }

            over "Front_Right_motor_mount_003"
            {
                double3 xformOp:translate = (-0.06499934196472168, -0.00027683377265930176, 0)

                over "Cylinder_103"
                {
                    bool physics:collisionEnabled = 0
                }
            }

            def Scope "Colliders"
            {
                def Cylinder "Wheel" (
                    prepend apiSchemas = ["PhysicsCollisionAPI"]
                )
                {
                    uniform token axis = "X"
                    double height = 0.1
                    bool physics:collisionEnabled = 1
                    uniform token purpose = "guide"
                    double radius = 0.127
                }
            }
        }

        over "Rear_Right_wheel" (
            prepend apiSchemas = ["PhysicsMassAPI"]
